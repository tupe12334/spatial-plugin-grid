{
  "name": "spatial-plugin-grid",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "build": "vite build && tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:pack": "node scripts/pack-consumer.mjs",
    "test:release": "node --test scripts/release-guard.test.mjs",
    "test:release-tooling": "node --test scripts/input-guard.test.mjs scripts/commitlint.test.mjs scripts/changelog-entry.test.mjs scripts/release-preflight.test.mjs scripts/release-it-dry-run.test.mjs",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "release-it",
    "release:dry": "release-it --dry-run --ci",
    "validate": "node scripts/validate.mjs",
    "test:visual": "node scripts/browser-docker.mjs visual",
    "test:visual:update": "node scripts/browser-docker.mjs update",
    "test:browsers": "node scripts/browser-docker.mjs all",
    "test:baseline-guard": "node scripts/baseline-guard.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.63.0",
    "@storybook/react": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "husky": "9.1.7",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "release-it": "21.0.3",
    "semver": "7.7.4",
    "storybook": "10.5.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupe12334/spatial-plugin-grid.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
